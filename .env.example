# Copier ce fichier en .env (ignoré par git) et l'adapter.

# Base PostgreSQL (docker-compose-local.yml fournit ces valeurs)
DB_URL=jdbc:postgresql://localhost:5432/local
DB_USERNAME=postgres
DB_PASSWORD=postgres
# update garde les données entre deux lancements ; create-drop repart d'une base vide
DB_JPA_DDL_AUTO=update

# Clé gratuite sur https://openrouteservice.org/dev/#/signup
# Laisser vide pour le mode estimation : distances à vol d'oiseau, sans le moteur VROOM.
ORS_KEY=
# Instance ORS auto-hébergée (voir OpenRouteService/SETUP.md)
# ORS_URL=http://localhost:8082/ors