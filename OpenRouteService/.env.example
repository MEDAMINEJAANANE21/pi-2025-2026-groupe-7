# OpenRouteService Environment Variables
# Copy this file to .env and adjust values as needed

# Graph building - set to True to force rebuild on startup
REBUILD_GRAPHS=False

# Logging level: DEBUG, INFO, WARN, ERROR
CONTAINER_LOG_LEVEL=INFO

# Java memory settings (adjust based on your server resources)
# Minimum heap size
XMS=1g
# Maximum heap size
XMX=2g

# Port mapping (format: HOST_PORT:CONTAINER_PORT)
# For VPN binding, use: VPN_IP:8080:8080
PORT_MAPPING=8080:8080

# Uncomment and set your VPN IP if using VPN binding
# VPN_IP=10.8.0.1
